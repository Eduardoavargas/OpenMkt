{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": { "outputs": [] },
    "typecheck": { "outputs": [] },
    "test": { "outputs": ["coverage/**"] },
    "test:integration": { "outputs": ["coverage/**"], "cache": false },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] }
  }
}
